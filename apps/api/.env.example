# =============================================================================
# AI-Growth-OS API — copy to apps/api/.env
# =============================================================================

DATABASE_URL=postgresql://growthos:growthos@localhost:5433/growthos
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=dev-only-change-me-32chars-min!!
JWT_SECRET=dev-jwt-secret-change-in-production-min-32
JWT_EXPIRES_IN=7d
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# WordPress: 1 = local mock; 0 = real plugin (npm run wp:up → http://localhost:8080)
MOCK_WP_HEALTH=1
# MOCK_WP_DEPLOY=1
# FORCE_VERIFY_FAIL=1

# Optional — without this, proposals use deterministic rules
# OPENAI_API_KEY=

# Web research (AI search) — https://tavily.com
# TAVILY_API_KEY=

# SEO / SERP / keyword / rank data (SerpAPI, DataForSEO, …)
# SERP_API_KEY=
# SERP_PROVIDER=serpapi

# Phase 7+
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENTRY_DSN=
