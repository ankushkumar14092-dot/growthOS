# =============================================================================
# AI-Growth-OS — root env template
# Copy to `.env` (and keep apps/api/.env + apps/web/.env.local in sync)
# =============================================================================

# --- Infra (docker compose: Postgres host 5433, Redis 6379) ---
DATABASE_URL=postgresql://growthos:growthos@localhost:5433/growthos
REDIS_URL=redis://localhost:6379

# --- Secrets (change in production; keep ENCRYPTION_KEY stable or credentials break) ---
ENCRYPTION_KEY=dev-only-change-me-32chars-min!!
JWT_SECRET=dev-jwt-secret-change-in-production-min-32
JWT_EXPIRES_IN=7d

# --- API ---
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- WordPress ---
# 1 = mock (quick demos). 0 = real plugin (npm run wp:up → http://localhost:8080)
MOCK_WP_HEALTH=1
# MOCK_WP_DEPLOY=1
# MOCK_WP_STORAGE=apps/api/storage/mock-wp
# FORCE_VERIFY_FAIL=1

# --- Optional ---
# OPENAI_API_KEY=
#
# Web research (AI search) — https://tavily.com
# TAVILY_API_KEY=
#
# SEO / SERP / keyword / rank data (SerpAPI, DataForSEO, etc.)
# SERP_API_KEY=
# SERP_PROVIDER=serpapi
#
# Phase 7+ — Razorpay billing (https://razorpay.com)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_STARTER=plan_...
# RAZORPAY_PLAN_AGENCY=plan_...
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
